APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/careeros?sslmode=disable
# Supabase production example:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_DELAY=2s

REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_RETRIES=5
REDIS_CONNECT_RETRY_DELAY=2s

JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=careeros-api

MAIL_FROM=no-reply@careeros.local
MAIL_PROVIDER=log
RESEND_API_KEY=
RESUME_BUILDER_TEST_EMAILS=candidate@jobsview.local
# Production email example:
# MAIL_PROVIDER=resend
# MAIL_FROM=Jobs View <no-reply@your-domain.com>
# RESEND_API_KEY=re_...

# Candidate checkout (use Razorpay test keys until go-live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

STORAGE_PROVIDER=local
STORAGE_BUCKET=careeros-assets
STORAGE_BASE_URL=http://localhost:8080/assets

CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
RATE_LIMIT_MAX=60
RATE_LIMIT_EXPIRATION=1m

# Production-only hardening
# APP_ENV=production requires:
# - JWT_ACCESS_SECRET and JWT_REFRESH_SECRET with 32+ characters
# - CORS_ALLOW_ORIGINS without localhost or wildcard
# - RESEND_API_KEY when MAIL_PROVIDER=resend
# - Razorpay key ID, key secret and webhook secret
# - STORAGE_BASE_URL when STORAGE_PROVIDER is not local
