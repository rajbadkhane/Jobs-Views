# API Configuration
PORT=8080
ENV=development # development, staging, production

# Database Connections
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/careeros?sslmode=disable
# Supabase transaction pooler production example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0
# Upstash production example:
# REDIS_URL=rediss://default:<password>@<upstash-host>:6379

# Security
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_123!

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_BUCKET=careeros-assets
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Candidate Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EMPLOYER_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_UPLOAD_MAX_BYTES=10485760
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_MONITORING_ENDPOINT=
NEXT_PUBLIC_MONITORING_SAMPLE_RATE=1
NEXT_PUBLIC_RELEASE=local
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_SESSION_WARNING_MS=255600000
NEXT_PUBLIC_QUERY_STALE_MS=60000
NEXT_PUBLIC_QUERY_GC_MS=600000

# Production deployment examples
# NEXT_PUBLIC_API_URL=https://<render-api-domain>/api/v1
# NEXT_PUBLIC_SITE_URL=https://<web-domain>
# NEXT_PUBLIC_EMPLOYER_URL=https://<employer-domain>
# NEXT_PUBLIC_ADMIN_URL=https://<admin-domain>

# Production security
CORS_ALLOW_ORIGINS=https://<web-domain>,https://<admin-domain>,https://<employer-domain>
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_characters

# Mail
MAIL_PROVIDER=log
MAIL_FROM=Jobs View <no-reply@your-domain.com>
RESEND_API_KEY=
# Production email example:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
RESUME_BUILDER_TEST_EMAILS=candidate@jobsview.local
